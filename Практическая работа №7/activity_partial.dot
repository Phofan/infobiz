digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Arial", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Создать заказ сотрудника в статусе DRAFT"];
n2 [label="Получить товар Product и количество quantity", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n3 [label="A1: Проверить статус заказа == DRAFT,\nid и name не пустые, price > 0,\n1 <= quantity <= 100 (при объединении delta <= 20)", fillcolor="#E2F0D9", color="#548235"];
n4 [label="Позиция корректна?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n5 [label="Товар с таким productId уже есть в заказе?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n6 [label="Увеличить количество через increase(delta)\nили добавить новый OrderItem в items"];
n7 [label="Есть ещё позиции?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n8 [label="Вычислить итоговую стоимость total()\nсуммированием getLineTotal() всех позиций"];
n9 [label="A2: Проверить status == DRAFT и !items.isEmpty(),\nперевести заказ в статус CONFIRMED\nи заблокировать дальнейшие изменения", fillcolor="#E2F0D9", color="#548235"];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4;
n4 -> n5 [label="да"];
n4 -> n2 [label="нет"];
n5 -> n6 [label="да / нет"];
n6 -> n7;
n7 -> n2 [label="да"];
n7 -> n8 [label="нет"];
n8 -> n9;
n9 -> end;
}
