digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
node [shape=record, style="filled", fontname="Arial", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Arial", fontsize=9, color="#555555"];
p [label="{Product|- id : String\l- name : String\l- price : double\l|+ Product(String, String, double)\l+ getId() : String\l+ getName() : String\l+ getPrice() : double\l}", fillcolor="#F7FBFF", color="#2F5597"];
e [label="{Employee|- id : String\l- fullName : String\l|+ Employee(String, String)\l+ id() : String\l+ fullName() : String\l}", fillcolor="#F7FBFF", color="#2F5597"];
st [label="{OrderStatus||DRAFT\lCONFIRMED\l}", fillcolor="#F7FBFF", color="#2F5597"];
oi [label="{OrderItem|+ MIN_QUANTITY : int = 1\l+ MAX_QUANTITY : int = 100\l+ MAX_MERGE_DELTA : int = 20\l- product : Product\l- quantity : int\l|+ OrderItem(Product, int)\l- setQuantity(int) : void\l+ increase(int) : void\l+ getProduct() : Product\l+ getQuantity() : int\l+ getLineTotal() : double\l}", fillcolor="#F7FBFF", color="#2F5597"];
o [label="{Order|- employee : Employee\l- items : List\<OrderItem\>\l- status : OrderStatus\l|+ Order(Employee)\l+ addProduct(Product, int) : void\l+ removeProduct(String) : void\l+ total() : double\l+ confirm() : void\l- ensureDraft() : void\l+ getEmployee() : Employee\l+ getItems() : List\<OrderItem\>\l+ getStatus() : OrderStatus\l}", fillcolor="#F7FBFF", color="#2F5597"];
s [label="{OrderService||+ createOrder(Employee) : Order\l+ validateForConfirm(Order) : void\l+ confirmOrder(Order) : void\l+ main(String[]) : void\l}", fillcolor="#F7FBFF", color="#2F5597"];
sc [label="{SelfCheck||+ main(String[]) : void\l}", fillcolor="#F7FBFF", color="#2F5597"];
o -> e [label="1", arrowtail=odiamond, dir=both];
o -> oi [label="1..*", arrowtail=diamond, dir=both];
o -> st [label="1", style=dashed, arrowhead=open];
oi -> p [label="1", arrowtail=odiamond, dir=both];
s -> o [label="uses", style=dashed, arrowhead=open];
sc -> s [label="tests", style=dashed, arrowhead=open];
}
