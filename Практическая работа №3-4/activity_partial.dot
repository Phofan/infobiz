digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Arial", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить количество, цену, скидку и ставку НДС", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n2 [label="A1: Проверить диапазоны:\n1 <= quantity <= 10000,\n0 < unitPrice <= 5000000,\n0 <= discountPercent <= 30", fillcolor="#E2F0D9", color="#548235"];
n3 [label="Данные корректны?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n4 [label="Вычислить базовую сумму:\nbase = quantity * unitPrice"];
n5 [label="A2: Применить скидку discounted = base * (1 - discount/100),\nвычислить НДС vat = discounted * (vatRate/100),\nитог total = discounted + vat и проверить порог >= 20 ед.", fillcolor="#E2F0D9", color="#548235"];
n6 [label="Вывести результат в рублях с двумя знаками после запятой"];
n7 [label="Вывести сообщение с причиной ошибки валидации"];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4 [label="да"];
n3 -> n7 [label="нет"];
n4 -> n5;
n5 -> n6;
n6 -> end;
n7 -> end;
}
