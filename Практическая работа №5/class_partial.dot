digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
node [shape=record, style="filled", fontname="Arial", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Arial", fontsize=9, color="#555555"];
a [label="{TimesheetAnalyzer|+ DAYS_IN_WEEK : int = 5\l+ MIN_HOURS : int = 0\l+ MAX_HOURS : int = 16\l+ DAILY_NORM : int = 8\l+ WEEKLY_NORM : int = 20\l|+ parseHours(String) : int[]\l+ total(int[]) : int\l+ average(int[]) : double\l+ overtimeDays(int[]) : int\l+ weeklyOvertime(int[]) : int\l+ formatReport(String) : String\l- validateArray(int[]) : void\l+ main(String[]) : void\l}", fillcolor="#F7FBFF", color="#2F5597"];
sc [label="{SelfCheck||+ main(String[]) : void\l- failsWithPosition(String, String) : boolean\l}", fillcolor="#F7FBFF", color="#2F5597"];
sc -> a [label="uses", style=dashed, arrowhead=open];
}
