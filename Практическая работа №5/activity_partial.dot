digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Arial", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить строку часов за неделю", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n2 [label="Проверить строку на пустоту и разделить через split(\";\", -1)"];
n3 [label="Ровно 5 значений?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n4 [label="A1: В цикле for (i = 0..4) преобразовать элемент через Integer.parseInt\nи проверить диапазон 0 <= hours[i] <= 16", fillcolor="#E2F0D9", color="#548235"];
n5 [label="Все элементы корректны?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n6 [label="Вычислить total(hours), average(hours),\novertimeDays(hours) и weeklyOvertime(hours)"];
n7 [label="A2: Сформировать итоговый текстовый отчёт\n(сумма, среднее, дни > 8 ч, переработка сверх 20 ч)", fillcolor="#E2F0D9", color="#548235"];
n8 [label="Сформировать сообщение об ошибке с указанием позиции (i + 1)"];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4 [label="да"];
n3 -> n8 [label="нет"];
n4 -> n5;
n5 -> n6 [label="да"];
n5 -> n8 [label="нет"];
n6 -> n7;
n7 -> end;
n8 -> end;
}
