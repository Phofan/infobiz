digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Arial", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить и проверить параметры заявки\n(amount > 0, risk != null)", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n2 [label="containsPersonalData == true?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n3 [label="A1: Перейти к проверке уровня риска\nпо приоритету после проверки ПДн", fillcolor="#E2F0D9", color="#548235"];
n4 [label="risk == HIGH?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n5 [label="amount >= 500 000?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n6 [label="urgent == true и допустим FAST_TRACK\n(LOW или MEDIUM <= 100 000)?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n7 [label="Вернуть маршрут согласования ApprovalRoute"];
start -> n1;
n1 -> n2;
n2 -> n7 [label="да -> SECURITY_REVIEW"];
n2 -> n3 [label="нет"];
n3 -> n4;
n4 -> n7 [label="да -> DIRECTOR_REVIEW"];
n4 -> n5 [label="нет"];
n5 -> n7 [label="да -> FINANCE_REVIEW"];
n5 -> n6 [label="нет"];
n6 -> n7 [label="да -> FAST_TRACK"];
n6 -> n7 [label="нет -> STANDARD"];
n7 -> end;
}
