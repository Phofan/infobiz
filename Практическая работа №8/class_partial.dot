digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
node [shape=record, style="filled", fontname="Arial", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Arial", fontsize=9, color="#555555"];
t [label="{BusinessTrip|+ MIN_REJECTION_REASON_LENGTH : int = 10\l+ MAX_TRIP_DAYS : long = 20\l- id : String\l- start : LocalDate\l- end : LocalDate\l- status : TripStatus\l- rejectionReason : String\l|+ BusinessTrip(String, LocalDate, LocalDate)\l+ submit() : void\l+ approve() : void\l+ reject(String) : void\l+ cancel() : void\l+ complete(LocalDate) : void\l+ getId() : String\l+ getStart() : LocalDate\l+ getEnd() : LocalDate\l+ getStatus() : TripStatus\l+ getRejectionReason() : String\l}", fillcolor="#F7FBFF", color="#2F5597"];
st [label="{TripStatus||DRAFT\lSUBMITTED\lAPPROVED\lREJECTED\lCANCELLED\lCOMPLETED\l}", fillcolor="#F7FBFF", color="#2F5597"];
sv [label="{BusinessTripService|- trips : List\<BusinessTrip\>\l|+ create(String, LocalDate, LocalDate) : BusinessTrip\l+ findByStatus(TripStatus) : List\<BusinessTrip\>\l+ main(String[]) : void\l}", fillcolor="#F7FBFF", color="#2F5597"];
sc [label="{SelfCheck||+ main(String[]) : void\l}", fillcolor="#F7FBFF", color="#2F5597"];
t -> st [label="1", style=dashed, arrowhead=open];
sv -> t [label="manages", style=dashed, arrowhead=open];
sc -> sv [label="tests", style=dashed, arrowhead=open];
}
